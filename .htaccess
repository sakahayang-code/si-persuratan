# SI-PERSURATAN - Apache & LiteSpeed Configuration for cPanel
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Protect Sensitive Directories & Files from direct HTTP access
    RewriteRule ^(app|config|migrations|storage|docs|vendor) - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^\.git - [F,L,NC]
    RewriteRule ^\.env - [F,L,NC]

    # 2. If physical file exists directly, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. If directory, let DirectoryIndex handle index.html
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Fallback for non-existent routes
    RewriteRule ^(.*)$ index.html [L,QSA]
</IfModule>

# Ensure accurate MIME types for static assets
<IfModule mod_mime.c>
    AddType text/html .html .htm
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/png .png
    AddType image/x-icon .ico
    AddType application/manifest+json .json
</IfModule>

# Security: Disable directory listing
Options -Indexes

# UTF-8 Encoding default
AddDefaultCharset UTF-8

# Allow cross-origin for fonts/icons/css
<IfModule mod_headers.c>
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|js|svg)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
